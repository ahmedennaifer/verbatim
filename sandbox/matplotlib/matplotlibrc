# House chart style, matching the web app (ember accent, ink neutrals). Loaded via MATPLOTLIBRC.
axes.prop_cycle: cycler('color', ['e5603c', '2b2f3a', '8b909c', 'f0a58a', '5a6072', 'c9ccd3'])
axes.facecolor: white
axes.edgecolor: c9ccd3
axes.linewidth: 0.8
axes.spines.top: False
axes.spines.right: False
axes.grid: True
axes.grid.axis: y
axes.axisbelow: True
axes.titlesize: 13
axes.titleweight: bold
axes.titlelocation: left
axes.titlepad: 14
axes.labelsize: 10
axes.labelcolor: 4b5060
grid.color: e8eaee
grid.linewidth: 0.8
xtick.color: 5b6070
ytick.color: 5b6070
xtick.labelsize: 9.5
ytick.labelsize: 9.5
xtick.major.size: 0
ytick.major.size: 0
legend.frameon: False
legend.fontsize: 9.5
font.family: sans-serif
font.sans-serif: Helvetica Neue, Helvetica, Arial, DejaVu Sans
text.color: 1f222b
figure.facecolor: white
figure.figsize: 8, 4.5
figure.dpi: 110
savefig.dpi: 200
savefig.bbox: tight
savefig.facecolor: white
